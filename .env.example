# salo-run (dashboard) — environment template
#
# Copy to .env.local and adjust. .env.local is git-ignored.
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put a secret
# behind that prefix.

# The public site (knockout); login redirects go there.
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# This dashboard's own public origin (read by getAppUrl() in lib/urls.ts).
# Leave it unset and some links silently become bare paths.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Browser API calls go to this app's OWN same-origin proxy (/api/proxy), which
# rewrites the auth cookie for localhost so a login on :3000 is visible here.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/proxy

# Server-side only (no NEXT_PUBLIC_ prefix): what the proxy forwards to.
# Live data: https://backend.connekyt.com   Local backend: http://localhost:8080
BACKEND_API_URL=https://backend.connekyt.com
